--- /dev/null
+++ b/apps/backend/src/middleware/embed-frame-ancestors.ts
@@ -0,0 +1,27 @@
+import type { FastifyReply, FastifyRequest } from 'fastify';
+
+import { env } from '../env';
+
+const EMBED_PATH_PREFIX = '/embed';
+
+/** True for `/embed` and any `/embed/...` path, the client-routed lane in apps/frontend/src/routes/embed*. */
+export function isEmbedPath(url: string): boolean {
+	const pathname = url.split('?', 1)[0];
+	return pathname === EMBED_PATH_PREFIX || pathname.startsWith(`${EMBED_PATH_PREFIX}/`);
+}
+
+/**
+ * `onSend` hook: only the /embed/* lane gets a framing policy. `SUPERSET_EMBED_ORIGIN` is pasted verbatim
+ * after `frame-ancestors`, so several origins go space-separated; unset keeps the lane same-origin only.
+ * `X-Frame-Options` cannot name one foreign origin, which is why this is a CSP directive.
+ */
+export async function applyEmbedFrameAncestors(
+	request: FastifyRequest,
+	reply: FastifyReply,
+	payload: unknown,
+): Promise<unknown> {
+	if (isEmbedPath(request.url)) {
+		reply.header('content-security-policy', `frame-ancestors ${env.SUPERSET_EMBED_ORIGIN ?? "'self'"}`);
+	}
+	return payload;
+}
diff --git a/apps/backend/tests/middleware/embed-frame-ancestors.test.ts b/apps/backend/tests/middleware/embed-frame-ancestors.test.ts
new file mode 100644
index 0000000..6768d60
--- /dev/null
+++ b/apps/backend/tests/middleware/embed-frame-ancestors.test.ts
@@ -0,0 +1,51 @@
+import '../../src/env';
+
+import fastify from 'fastify';
+import { afterEach, describe, expect, it } from 'vitest';
+
+import { __reloadEnvForTesting } from '../../src/env';
+import { applyEmbedFrameAncestors } from '../../src/middleware/embed-frame-ancestors';
+
+const ORIGIN_ENV_KEY = 'SUPERSET_EMBED_ORIGIN';
+const previousOrigin = process.env[ORIGIN_ENV_KEY];
+
+const csp = async (url: string, origin: string | undefined) => {
+	if (origin === undefined) {
+		delete process.env[ORIGIN_ENV_KEY];
+	} else {
+		process.env[ORIGIN_ENV_KEY] = origin;
+	}
+	__reloadEnvForTesting();
+
+	const app = fastify({ logger: false });
+	app.addHook('onSend', applyEmbedFrameAncestors);
+	app.get('/embed/chat', async () => ({ ok: true }));
+	app.get('/api/whoami', async () => ({ ok: true }));
+	await app.ready();
+	return (await app.inject({ method: 'GET', url })).headers['content-security-policy'];
+};
+
+describe('embed frame-ancestors', () => {
+	afterEach(() => {
+		if (previousOrigin === undefined) {
+			delete process.env[ORIGIN_ENV_KEY];
+		} else {
+			process.env[ORIGIN_ENV_KEY] = previousOrigin;
+		}
+		__reloadEnvForTesting();
+	});
+
+	it('lets the configured origins frame an embed route', async () => {
+		expect(await csp('/embed/chat?dashboard_id=1', 'http://localhost:8088 https://bi.example.com')).toBe(
+			'frame-ancestors http://localhost:8088 https://bi.example.com',
+		);
+	});
+
+	it('keeps an embed route same-origin only when nothing is configured', async () => {
+		expect(await csp('/embed/chat', undefined)).toBe("frame-ancestors 'self'");
+	});
+
+	it('leaves every other route without a policy', async () => {
+		expect(await csp('/api/whoami', 'http://localhost:8088')).toBeUndefined();
+	});
+});
