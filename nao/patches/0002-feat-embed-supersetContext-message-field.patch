diff --git a/apps/backend/tests/superset-context-block.test.ts b/apps/backend/tests/superset-context-block.test.ts
new file mode 100644
index 0000000..c6a9d0d
--- /dev/null
+++ b/apps/backend/tests/superset-context-block.test.ts
@@ -0,0 +1,39 @@
+import { describe, expect, it } from 'vitest';
+
+import { buildSupersetContextBlock } from '../src/services/superset-context-block';
+
+describe('buildSupersetContextBlock', () => {
+	it('is undefined when no identifier is set, so an empty object never reaches the turn', () => {
+		expect(buildSupersetContextBlock({})).toBeUndefined();
+		expect(buildSupersetContextBlock({ dashboardId: '' })).toBeUndefined();
+	});
+
+	it('states every identifier it was given', () => {
+		const block = buildSupersetContextBlock({
+			dashboardId: '13',
+			chartId: '456',
+			filters: 'country=US',
+			timeRange: 'Last 7 days',
+		});
+		expect(block).toContain('Dashboard id: 13');
+		expect(block).toContain('Chart id: 456');
+		expect(block).toContain('Filters active on it: country=US');
+		expect(block).toContain('Time range selected on it: Last 7 days');
+	});
+
+	it('tells the model to look the dashboard up by its id', () => {
+		expect(buildSupersetContextBlock({ dashboardId: '13' })).toContain('Search the project context for "13"');
+	});
+
+	it('omits the lookup instruction when there is no dashboard id to look up', () => {
+		const block = buildSupersetContextBlock({ chartId: '456' });
+		expect(block).toContain('Chart id: 456');
+		expect(block).not.toContain('Search the project context');
+	});
+
+	it('is bracketed so the model reads it as provenance, not as the question', () => {
+		const block = buildSupersetContextBlock({ dashboardId: '13' });
+		expect(block?.startsWith('[')).toBe(true);
+		expect(block?.endsWith(']')).toBe(true);
+	});
+});
