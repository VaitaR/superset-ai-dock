diff --git a/apps/backend/src/services/superset-context-block.ts b/apps/backend/src/services/superset-context-block.ts
new file mode 100644
index 0000000..7223ab2
--- /dev/null
+++ b/apps/backend/src/services/superset-context-block.ts
@@ -0,0 +1,38 @@
+import type { SupersetContext } from '@nao/shared/types';
+
+/**
+ * How Superset identifiers are phrased for the model. They travel as a field on the user message,
+ * so this is the single place their wording is decided.
+ *
+ * A bare id is useless to the model, so the block names the lookup instead: the project context
+ * keys dashboards by their numeric id, which the context tools can search for.
+ *
+ * Returns `undefined` when the context carries no identifier worth stating.
+ */
+export function buildSupersetContextBlock({
+	dashboardId,
+	chartId,
+	filters,
+	timeRange,
+}: SupersetContext): string | undefined {
+	const lines = [
+		dashboardId && `Dashboard id: ${dashboardId}`,
+		chartId && `Chart id: ${chartId}`,
+		filters && `Filters active on it: ${filters}`,
+		timeRange && `Time range selected on it: ${timeRange}`,
+	].filter((line): line is string => Boolean(line));
+	if (lines.length === 0) {
+		return undefined;
+	}
+
+	return [
+		'[The user is asking from a Superset dashboard.',
+		...lines,
+		dashboardId
+			? `Search the project context for "${dashboardId}" before answering: dashboards are keyed by that id, and the entry says what the dashboard measures and which tables it reads. Do not assume what it shows.`
+			: '',
+		'Answer the question itself; this is where it came from, not what was asked.]',
+	]
+		.filter(Boolean)
+		.join('\n');
+}
