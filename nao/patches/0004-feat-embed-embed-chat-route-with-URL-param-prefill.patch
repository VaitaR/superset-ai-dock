+// @vitest-environment jsdom
+
+import { renderHook } from '@testing-library/react';
+import { afterEach, describe, expect, it, vi } from 'vitest';
+
+import { useSupersetEmbedPrefill } from './use-superset-embed-prefill';
+import type { SupersetLinkSearch } from '@/lib/superset-link-prefill';
+import { chatPendingSupersetContextStore } from '@/stores/chat-pending-superset-context';
+
+const setup = (search: SupersetLinkSearch) => {
+	const queueOrSendMessage = vi.fn();
+	const setChatInputText = vi.fn();
+	const clearSearchParams = vi.fn();
+	const view = renderHook(
+		(props: SupersetLinkSearch) =>
+			useSupersetEmbedPrefill({ search: props, queueOrSendMessage, setChatInputText, clearSearchParams }),
+		{ initialProps: search },
+	);
+	return { queueOrSendMessage, setChatInputText, clearSearchParams, ...view };
+};
+
+describe('useSupersetEmbedPrefill', () => {
+	afterEach(() => chatPendingSupersetContextStore.clear());
+
+	it('prefills the composer with the bare question and holds the identifiers as pending context', () => {
+		const { queueOrSendMessage, setChatInputText, clearSearchParams } = setup({
+			q: 'why did revenue drop?',
+			dashboardId: '75',
+		});
+
+		expect(setChatInputText).toHaveBeenCalledWith('why did revenue drop?');
+		expect(chatPendingSupersetContextStore.getSnapshot()).toEqual({ dashboardId: '75' });
+		expect(queueOrSendMessage).not.toHaveBeenCalled();
+		expect(clearSearchParams).toHaveBeenCalledTimes(1);
+	});
+
+	it('sends the question with the context as a field when autosend is set', () => {
+		const { queueOrSendMessage, setChatInputText } = setup({ q: 'why?', dashboardId: '75', autosend: true });
+
+		expect(queueOrSendMessage).toHaveBeenCalledWith({ text: 'why?', supersetContext: { dashboardId: '75' } });
+		expect(setChatInputText).not.toHaveBeenCalled();
+		expect(chatPendingSupersetContextStore.getSnapshot()).toBeNull();
+	});
+
+	it('does nothing when there are no Superset link params', () => {
+		const { queueOrSendMessage, setChatInputText, clearSearchParams } = setup({});
+
+		expect(queueOrSendMessage).not.toHaveBeenCalled();
+		expect(setChatInputText).not.toHaveBeenCalled();
+		expect(clearSearchParams).not.toHaveBeenCalled();
+	});
+
+	it('consumes the link only once across re-renders', () => {
+		const search = { q: 'why?' };
+		const { setChatInputText, clearSearchParams, rerender } = setup(search);
+		rerender(search);
+		rerender(search);
+
+		expect(setChatInputText).toHaveBeenCalledTimes(1);
+		expect(clearSearchParams).toHaveBeenCalledTimes(1);
+	});
+});
