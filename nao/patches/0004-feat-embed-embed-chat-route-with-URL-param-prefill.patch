+import { useEffect, useRef } from 'react';
+
+import type { SupersetLinkSearch } from '@/lib/superset-link-prefill';
+import type { SendMessageArgs } from '@/hooks/use-agent';
+import { chatPendingSupersetContextStore } from '@/stores/chat-pending-superset-context';
+import { buildSupersetContext, hasSupersetLinkParams } from '@/lib/superset-link-prefill';
+
+export interface UseSupersetEmbedPrefillArgs {
+	search: SupersetLinkSearch;
+	queueOrSendMessage: (message: Pick<SendMessageArgs, 'text' | 'supersetContext'>) => void | Promise<void>;
+	setChatInputText: (text: string) => void;
+	clearSearchParams: () => void;
+}
+
+/**
+ * Consumes the Superset link params once per page load: the identifiers go to the pending-context
+ * store (shown as a chip, sent beside the question), the question prefills the composer or, for
+ * `autosend`, is sent at once. The params are then stripped from the URL.
+ */
+export function useSupersetEmbedPrefill({
+	search,
+	queueOrSendMessage,
+	setChatInputText,
+	clearSearchParams,
+}: UseSupersetEmbedPrefillArgs): void {
+	const consumed = useRef(false);
+
+	useEffect(() => {
+		if (consumed.current || !hasSupersetLinkParams(search)) {
+			return;
+		}
+		consumed.current = true;
+
+		const supersetContext = buildSupersetContext(search);
+		if (search.q && search.autosend) {
+			void queueOrSendMessage({ text: search.q, supersetContext });
+		} else {
+			if (supersetContext) {
+				chatPendingSupersetContextStore.set(supersetContext);
+			}
+			if (search.q) {
+				setChatInputText(search.q);
+			}
+		}
+
+		clearSearchParams();
+	}, [search, queueOrSendMessage, setChatInputText, clearSearchParams]);
+}
