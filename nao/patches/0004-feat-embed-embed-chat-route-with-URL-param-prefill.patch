+import { createFileRoute, useNavigate } from '@tanstack/react-router';
+import { useCallback } from 'react';
+
+import { ChatInput } from '@/components/chat-input';
+import { ChatMessages } from '@/components/chat-messages/chat-messages';
+import { Button } from '@/components/ui/button';
+import { Spinner } from '@/components/ui/spinner';
+import { AgentProvider, useAgentContext } from '@/contexts/agent.provider';
+import { SetChatInputCallbackProvider, useSetChatInputCallback } from '@/contexts/set-chat-input-callback';
+import { useSupersetEmbedPrefill } from '@/hooks/use-superset-embed-prefill';
+import { useSession } from '@/lib/auth-client';
+import { parseSupersetLinkSearch } from '@/lib/superset-link-prefill';
+
+/**
+ * Compact chat for a Superset dashboard `<iframe>` tile (the header side is
+ * apps/backend/src/middleware/embed-frame-ancestors.ts). Only the conversation and the composer:
+ * no sidebar, chat list or account row, so it stays legible in a short tile.
+ *
+ * Auth is the ordinary session cookie, which the frame carries when it is same-site with Superset.
+ * Without a session it renders a compact sign-in prompt, since a redirect would break out of the tile.
+ */
+export const Route = createFileRoute('/embed/chat')({
+	validateSearch: parseSupersetLinkSearch,
+	component: EmbedChatPage,
+});
+
+function EmbedChatPage() {
+	const { data: session, isPending } = useSession();
+
+	if (isPending) {
+		return (
+			<div className='flex h-full min-h-0 flex-1 items-center justify-center'>
+				<Spinner className='size-5' />
+			</div>
+		);
+	}
+
+	if (!session) {
+		return <EmbedSignInPrompt />;
+	}
+
+	return (
+		<SetChatInputCallbackProvider>
+			<AgentProvider disableNavigation>
+				<EmbedChatContent />
+			</AgentProvider>
+		</SetChatInputCallbackProvider>
+	);
+}
+
+function EmbedSignInPrompt() {
+	return (
+		<div className='flex h-full min-h-0 flex-1 flex-col items-center justify-center gap-3 p-4 text-center'>
+			<p className='text-sm text-muted-foreground'>Sign in to use this chat.</p>
+			<Button asChild size='sm'>
+				<a href='/login' target='_top' rel='noopener noreferrer'>
+					Sign in
+				</a>
+			</Button>
+		</div>
+	);
+}
+
+function EmbedChatContent() {
+	const { messages, queueOrSendMessage } = useAgentContext();
+	const setChatInput = useSetChatInputCallback();
+	const search = Route.useSearch();
+	const navigate = useNavigate();
+
+	const clearSearchParams = useCallback(() => {
+		void navigate({ to: '/embed/chat', search: {}, replace: true });
+	}, [navigate]);
+
+	useSupersetEmbedPrefill({
+		search,
+		queueOrSendMessage,
+		setChatInputText: setChatInput.fire,
+		clearSearchParams,
+	});
+
+	return (
+		<div className='flex h-full min-h-0 flex-1 flex-col bg-panel'>
+			{messages.length > 0 && (
+				<div className='min-h-0 flex-1'>
+					<ChatMessages />
+				</div>
+			)}
+			<ChatInput />
+		</div>
+	);
+}
