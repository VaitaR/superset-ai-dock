@@ -0,0 +1,25 @@
+import { Store } from './abstract-store';
+import type { SupersetContext } from '@nao/shared/types';
+
+/**
+ * The Superset identifiers a link arrived with, held between landing on the page and the message
+ * being sent. Shown in the composer and dismissible there: the user can see, and refuse, what rides
+ * along with their question. Not keyed by chat id because the embed always starts a new chat.
+ */
+class ChatPendingSupersetContextStore extends Store<SupersetContext | null> {
+	protected state: SupersetContext | null = null;
+
+	set = (context: SupersetContext) => {
+		this.state = context;
+		this.notify();
+	};
+
+	clear = () => {
+		this.state = null;
+		this.notify();
+	};
+
+	getSnapshot = () => this.state;
+}
+
+export const chatPendingSupersetContextStore = new ChatPendingSupersetContextStore();
