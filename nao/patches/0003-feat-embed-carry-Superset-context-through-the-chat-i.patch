diff --git a/apps/frontend/src/lib/superset-link-prefill.ts b/apps/frontend/src/lib/superset-link-prefill.ts
new file mode 100644
index 0000000..cb3e1f0
--- /dev/null
+++ b/apps/frontend/src/lib/superset-link-prefill.ts
@@ -0,0 +1,68 @@
+/**
+ * Query params a Superset dashboard sends to the embedded chat:
+ * `?q=<question>&dashboard_id=&chart_id=&filters=&time_range=&autosend=1`.
+ *
+ * Every param arrives from a URL anyone can craft, so each is trimmed and length-capped. Only
+ * identifiers and volatile session state travel on the link; the agent looks dashboard and chart
+ * metadata up in its own project context.
+ */
+
+import { MAX_SUPERSET_CONTEXT_VALUE_LENGTH } from '@nao/shared/types';
+import type { SupersetContext } from '@nao/shared/types';
+
+export const MAX_QUESTION_LENGTH = 2000;
+export const MAX_CONTEXT_PARAM_LENGTH = MAX_SUPERSET_CONTEXT_VALUE_LENGTH;
+
+export interface SupersetLinkSearch {
+	q?: string;
+	dashboardId?: string;
+	chartId?: string;
+	filters?: string;
+	timeRange?: string;
+	autosend?: boolean;
+}
+
+function readCappedString(value: unknown, maxLength: number): string | undefined {
+	// The router's default search parser runs each value through `JSON.parse`, so `dashboard_id=75`
+	// arrives as the number 75; coerce it back to text instead of dropping it.
+	if (typeof value !== 'string' && typeof value !== 'number' && typeof value !== 'boolean') {
+		return undefined;
+	}
+	const trimmed = String(value).trim().slice(0, maxLength);
+	return trimmed.length > 0 ? trimmed : undefined;
+}
+
+/** TanStack Router `validateSearch` for the Superset link params. */
+export function parseSupersetLinkSearch(search: Record<string, unknown>): SupersetLinkSearch {
+	return {
+		q: readCappedString(search.q, MAX_QUESTION_LENGTH),
+		dashboardId: readCappedString(search.dashboard_id, MAX_CONTEXT_PARAM_LENGTH),
+		chartId: readCappedString(search.chart_id, MAX_CONTEXT_PARAM_LENGTH),
+		filters: readCappedString(search.filters, MAX_CONTEXT_PARAM_LENGTH),
+		timeRange: readCappedString(search.time_range, MAX_CONTEXT_PARAM_LENGTH),
+		// `undefined`, not `false`: the router serializes every defined search field back onto the
+		// URL, so a `false` would survive the post-prefill clear as a stray `?autosend=false`.
+		// The router re-validates its own normalized search, so the already-parsed `true` is accepted too.
+		autosend: search.autosend === '1' || search.autosend === 1 || search.autosend === true ? true : undefined,
+	};
+}
+
+/** True once any Superset link param is present and should be consumed and cleared from the URL. */
+export function hasSupersetLinkParams(search: SupersetLinkSearch): boolean {
+	return Boolean(search.q || search.dashboardId || search.chartId || search.filters || search.timeRange);
+}
+
+/**
+ * The identifiers as the structured field the agent request carries beside the question, never
+ * folded into the text: the backend owns how they are phrased for the model, and the question text
+ * also names the chat. Returns `undefined` when the link carried no identifiers.
+ */
+export function buildSupersetContext(search: SupersetLinkSearch): SupersetContext | undefined {
+	const context: SupersetContext = {
+		...(search.dashboardId && { dashboardId: search.dashboardId }),
+		...(search.chartId && { chartId: search.chartId }),
+		...(search.filters && { filters: search.filters }),
+		...(search.timeRange && { timeRange: search.timeRange }),
+	};
+	return Object.keys(context).length > 0 ? context : undefined;
+}
