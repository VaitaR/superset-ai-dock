@@ -0,0 +1,54 @@
+import { LayoutDashboard, X } from 'lucide-react';
+import type { SupersetContext } from '@nao/shared/types';
+
+import { cn } from '@/lib/utils';
+
+interface SupersetContextChipProps {
+	context: SupersetContext;
+	/** Omitted on a sent message, where there is nothing left to dismiss. */
+	onRemove?: () => void;
+	className?: string;
+}
+
+/**
+ * Shows what the Superset link attached to the question. It is visible on purpose: the
+ * identifiers are sent to the agent without appearing in the message text, and the user should be
+ * able to see that and drop it before sending.
+ */
+export const SupersetContextChip = ({ context, onRemove, className }: SupersetContextChipProps) => {
+	const parts = describeSupersetContext(context);
+	if (parts.length === 0) {
+		return null;
+	}
+
+	return (
+		<div
+			className={cn(
+				'flex items-center gap-2 px-3 py-1.5 border border-border/50 bg-background/50 rounded-lg text-xs text-muted-foreground',
+				className,
+			)}
+		>
+			<LayoutDashboard className='size-3.5 shrink-0' />
+			<span className='truncate'>{parts.join(' · ')}</span>
+			{onRemove ? (
+				<button
+					type='button'
+					onClick={onRemove}
+					aria-label='Remove Superset context'
+					className='ml-auto shrink-0 cursor-pointer hover:text-foreground transition-colors'
+				>
+					<X className='size-3.5' />
+				</button>
+			) : null}
+		</div>
+	);
+};
+
+export function describeSupersetContext({ dashboardId, chartId, filters, timeRange }: SupersetContext): string[] {
+	return [
+		dashboardId && `Dashboard ${dashboardId}`,
+		chartId && `Chart ${chartId}`,
+		timeRange && `Time range: ${timeRange}`,
+		filters && `Filters: ${filters}`,
+	].filter((part): part is string => Boolean(part));
+}
